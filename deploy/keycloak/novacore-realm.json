{
  "realm": "novacore",
  "enabled": true,
  "displayName": "NovaCore (example)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "Administrator", "description": "NovaCore super-admin: passes every permission check" },
      { "name": "User", "description": "Standard user" }
    ]
  },
  "clients": [
    {
      "clientId": "novacore-scalar",
      "name": "NovaCore API reference (Scalar)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:5443/scalar/*",
        "http://localhost:5080/scalar/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:5443/scalar/*##http://localhost:5080/scalar/*"
      },
      "protocolMappers": [
        {
          "name": "novacore.api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "novacore.api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles as role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
