<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This repository's package sources. Everything comes from nuget.org except the BMD.NovaCore.* packages, which only
    package validation downloads: packing with -p:PackageValidationBaselineVersion=<v> adds the previous release of
    each library package as a PackageDownload, and the packages are compared with it (docs/plan/RESEARCH.md R-162).
    Package source mapping sends each package to exactly one source, so a restore without that property never contacts
    the novacore feed and needs no token.
    The novacore feed needs a GitHub token with read:packages (D-050), never kept in this file. NuGet finds it by the
    source name, novacore: on your machine in your user-level NuGet config, in CI in the
    NuGetPackageSourceCredentials_novacore environment variable ("Username=<user>;Password=<token>").
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="novacore" value="https://nuget.pkg.github.com/alimuhammedak/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="novacore">
      <package pattern="BMD.NovaCore.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
