<Project Sdk="Microsoft.NET.Sdk">

  <!-- xUnit v3 test project on Microsoft.Testing.Platform: unit, integration (WebApplicationFactory) and architecture tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit1051: prefer TestContext cancellation token — noise for these simple HttpClient calls. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- The PostgreSQL test layer's provider; its migrations live in this project (PostgreSql/<Module>/Migrations). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Lets `dotnet ef` add the PostgreSQL migrations with this project as the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Respawn" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\NovaCore.Api\NovaCore.Api.csproj" />
    <!-- The identity provider add-on, tested on its own host (IdentityServer/) the way a package consumer composes it. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\NovaCore.Identity.OpenIddict\NovaCore.Identity.OpenIddict.csproj" />
  </ItemGroup>

</Project>
