<Project>

  <!--
    Package metadata for packable projects (the NuGet packages). It depends on IsPackable, which each .csproj sets, so
    it lives here: Directory.Build.props is imported before the project body and would only ever see an empty value
    (docs/plan/RESEARCH.md R-032). These properties are read when pack runs, so setting them this late is fine.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <!--
      Package IDs carry the BMD prefix: other owners already publish NovaCore.* packages on nuget.org (NovaCore.AspNetCore,
      NovaCore.Templates, ...), and a package ID must be unique wherever it can be resolved (docs/plan/DECISIONS.md
      D-041). Assembly and namespace names stay NovaCore.*: BMD.NovaCore.AspNetCore contains NovaCore.AspNetCore.dll.
    -->
    <PackageId>BMD.$(MSBuildProjectName)</PackageId>
    <Authors>Muhammed Ali AK</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alimuhammedak/NovaCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Lock files (docs/plan/DECISIONS.md D-048, RESEARCH R-094): the host, the modules and the tests record their whole
    package graph in packages.lock.json, and CI restores in locked mode. Packages get none: the projects that depend on a
    library don't use its lock file (NuGet's guidance). Like the metadata above, it depends on IsPackable; restore reads
    it after evaluation, so setting it here works.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'true'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    Symbols, package validation, XML docs and the public API baseline concern assemblies. A template package
    (PackageType=Template, src/Templates) packs files only, so none of them applies to it.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' And '$(PackageType)' != 'Template'">
    <NovaCoreLibraryPackage>true</NovaCoreLibraryPackage>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)src/PACKAGE.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>

  <!--
    XML docs can't be switched on from here (the SDK has already computed DocumentationFile, R-040), so each packable
    .csproj sets GenerateDocumentationFile itself. This check stops a new package from shipping without docs.
  -->
  <Target Name="NovaCoreRequirePackageDocumentation" BeforeTargets="CoreCompile"
          Condition="'$(NovaCoreLibraryPackage)' == 'true' And '$(DocumentationFile)' == ''">
    <Error Text="$(MSBuildProjectName) is packable but generates no XML documentation. Set &lt;GenerateDocumentationFile&gt;true&lt;/GenerateDocumentationFile&gt; next to IsPackable in its .csproj (docs/plan/DECISIONS.md D-014)." />
  </Target>

  <!--
    The analyzer reads the project's PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt (its buildTransitive targets add
    them, docs/plan/RESEARCH.md R-118; everything goes to Unshipped until a release is declared, F5.4). Without the
    reference, a new package would silently ship an untracked public API, so a packable project without it fails the
    build (D-020).
  -->
  <Target Name="NovaCoreRequirePublicApiTracking" BeforeTargets="CoreCompile" Condition="'$(NovaCoreLibraryPackage)' == 'true'">
    <ItemGroup>
      <_NovaCorePublicApiAnalyzers Include="@(PackageReference)" Condition="'%(Identity)' == 'Microsoft.CodeAnalysis.PublicApiAnalyzers'" />
    </ItemGroup>
    <Error Condition="'@(_NovaCorePublicApiAnalyzers)' == ''"
           Text="$(MSBuildProjectName) is packable but does not reference Microsoft.CodeAnalysis.PublicApiAnalyzers. Add &lt;PackageReference Include=&quot;Microsoft.CodeAnalysis.PublicApiAnalyzers&quot; PrivateAssets=&quot;all&quot; /&gt; to its .csproj (docs/plan/DECISIONS.md D-020)." />
  </Target>

</Project>
