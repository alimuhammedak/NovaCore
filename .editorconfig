root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
# Prefer modern C# idioms used throughout NovaCore.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_braces = when_multiline:silent
dotnet_sort_system_directives_first = true

[tests/**.cs]
# Test names are sentences (Refresh_rotates_the_refresh_token), as in Microsoft's unit-testing guidance (docs/plan/DECISIONS.md D-011).
dotnet_diagnostic.CA1707.severity = none

[src/**/Migrations/*.cs]
# EF Core migrations pass constant column arrays (composite indexes). Up/Down run once per database and the builder keeps
# the arrays, the two cases CA1861's documentation allows suppressing (docs/plan/RESEARCH.md R-064).
dotnet_diagnostic.CA1861.severity = none

[*.{csproj,props,targets}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
