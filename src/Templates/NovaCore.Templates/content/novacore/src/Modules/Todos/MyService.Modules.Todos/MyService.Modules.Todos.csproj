<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Todos: a sample vertical-slice module. It owns its domain, its DbContext (schema "todos") and its endpoints, and
    reaches other modules only through their *.Contracts projects or domain events. It chooses no database: the host
    does, and keeps the migrations. Keep the MyService.Modules. prefix for new modules.
  -->
  <ItemGroup>
    <PackageReference Include="BMD.NovaCore.AspNetCore" />
    <PackageReference Include="BMD.NovaCore.EntityFrameworkCore" />
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

</Project>
