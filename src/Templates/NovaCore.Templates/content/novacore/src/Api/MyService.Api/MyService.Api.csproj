<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host: a thin composition root over the NovaCore packages and the modules. -->
  <PropertyGroup>
    <UserSecretsId>myservice-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BMD.NovaCore.AspNetCore" />
    <PackageReference Include="BMD.NovaCore.EntityFrameworkCore" />
    <PackageReference Include="BMD.NovaCore.OpenTelemetry" />
    <PackageReference Include="BMD.NovaCore.Scalar" />
<!--#if (BuiltInAuth) -->
    <!-- The identity provider; its store is a context of this host's database. -->
    <PackageReference Include="BMD.NovaCore.Identity.OpenIddict" />
<!--#endif -->
<!--#if (multitenancy) -->
    <!-- The tenants, their members and roles; its store is a context of this host's database. -->
    <PackageReference Include="BMD.NovaCore.MultiTenancy" />
<!--#endif -->
    <!-- The database of every module context, chosen here (AddModuleDatabase); their migrations live in this project. -->
<!--#if (DbSqlServer) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Lifts SqlClient's vulnerable System.Security.Cryptography.Pkcs (see Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
<!--#endif -->
<!--#if (DbPostgreSql) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
<!--#endif -->
    <!-- Lets `dotnet ef` use this project for every context's migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Modules\Todos\MyService.Modules.Todos\MyService.Modules.Todos.csproj" />
  </ItemGroup>

</Project>
