{
  "Jwt": {
//#if (BuiltInAuth)
    // This host's own OpenID Connect provider. Run the https profile.
    "Authority": "https://localhost:5443"
//#else
    // The issuer URL of your OpenID Connect provider's development tenant or realm.
    "Authority": ""
//#endif
  },
//#if (BuiltInAuth)
  "Identity": {
    "Seed": {
      // Set SeedOnStartup to true, and the administrator's password with dotnet user-secrets, to seed the roles,
      // permissions, administrator and clients on startup.
      "SeedOnStartup": false
    },
    "Clients": [
      {
        // The Scalar UI (a public client: Authorization Code with PKCE). Its redirect URI is the Scalar page itself.
        "ClientId": "scalar",
        "DisplayName": "Scalar API reference",
        "RedirectUris": [ "https://localhost:5443/scalar/v1" ],
        "PostLogoutRedirectUris": [ "https://localhost:5443/scalar/v1" ]
      }
    ]
  },
//#endif
  "Database": {
    // true applies every module's migrations on startup (needs the SQL Server in ConnectionStrings:Database).
    "ApplyMigrations": false
  }
}
