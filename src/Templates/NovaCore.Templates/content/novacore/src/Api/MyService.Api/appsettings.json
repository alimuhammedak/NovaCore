// Production checklist. Before the first deployment, go through every "PRODUCTION:" note below.
// Secrets (passwords in connection strings, client secrets, the seed administrator's password) never go in this file:
// user secrets in Development (dotnet user-secrets), environment variables or a vault elsewhere.
{
  "ConnectionStrings": {
    // PRODUCTION: the deployment's connection string. The application's account needs data access only: the schema
    // changes ship as the migration bundles the CI workflow builds, run by a separate deployment account.
    "Database": "Server=localhost;Database=MyService;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;"
  },
  "Database": {
    // true applies every module's migrations on startup. Keep it false outside Development.
    "ApplyMigrations": false
  },
  "Jwt": {
//#if (BuiltInAuth)
    // PRODUCTION: this host's public https URL. The host is its own OpenID Connect provider and validates the tokens it
    // issues through this address. Required in every environment.
//#else
    // PRODUCTION: the issuer URL of the OpenID Connect provider that signs the access tokens (Entra ID, Keycloak, ...).
    // Required in every environment. Also register an IPermissionResolver for its users (Program.cs).
//#endif
    "Authority": "",
    "Audience": "myservice.api"
  },
//#if (BuiltInAuth)
  "Identity": {
    // PRODUCTION, also required by the identity provider outside Development (the host doesn't start without them):
    // - signing and encryption certificates: services.AddOpenIddict().AddServer(s => s.AddSigningCertificate(...)...);
    // - a real IEmailSender (confirmation and password reset links);
    // - a Data Protection key store, e.g. services.AddDataProtection().PersistKeysToFileSystem(<persistent volume>).
    "Seed": {
      // true seeds the roles, permissions, the administrator and Identity:Clients on startup (the database must be
      // migrated). The administrator's password comes from user secrets or the environment. The Administrator role
      // counts once the account has two-factor authentication: sign in, then POST /api/v1/auth/2fa/setup and /2fa/enable.
      "SeedOnStartup": false,
      "AdminEmail": "admin@myservice.local",
      "AdminPassword": ""
    }
  },
//#endif
  "Cache": {
    "DefaultExpiration": "00:05:00",
    // How long resolved permissions are cached: the longest a role change takes to reach a signed-in user.
    "PermissionExpiration": "00:05:00"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Cors": {
    // PRODUCTION: the browser origins allowed to call the API (https://app.example.com). Empty allows none outside
    // Development.
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    // PRODUCTION, behind a reverse proxy: its IP addresses (KnownProxies) or CIDR networks (KnownIPNetworks). Only their
    // X-Forwarded-For and X-Forwarded-Proto apply; empty applies nobody's.
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "HealthChecks": {
    // PRODUCTION: a management port for the orchestrator's probes (/health, /alive). The host must listen on it too,
    // e.g. ASPNETCORE_HTTP_PORTS=8080;8081. Empty maps no probes outside Development.
    "ProbePort": null
  },
  // PRODUCTION: logs, metrics and traces go over OTLP when OTEL_EXPORTER_OTLP_ENDPOINT is set (environment variable).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // PRODUCTION: the host names this API answers to (api.example.com), separated by ';'.
  "AllowedHosts": "*"
}
