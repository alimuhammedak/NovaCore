<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The NovaCore packages (BMD.NovaCore.*) come from their GitHub Packages feed, everything else from nuget.org. Package
    source mapping sends each package to exactly one source, so no other feed can serve a package under those names; with
    central package management NuGet also warns without it (NU1507), and warnings are errors here.
    The novacore feed needs a GitHub token with read:packages, never kept in this file. NuGet finds it by the source
    name, novacore: on your machine in your user-level NuGet config (once: dotnet nuget add source
    https://nuget.pkg.github.com/alimuhammedak/index.json -n novacore -u <github user> -p <token>), in CI in the
    NuGetPackageSourceCredentials_novacore environment variable ("Username=<user>;Password=<token>", from a secret).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="novacore" value="https://nuget.pkg.github.com/alimuhammedak/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="novacore">
      <package pattern="BMD.NovaCore.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
