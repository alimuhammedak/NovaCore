{
  "$schema": "http://json.schemastore.org/template",
  "author": "NovaCore",
  "classifications": [ "Web", "API", "Modular Monolith", "Vertical Slice" ],
  "identity": "NovaCore.ModularMonolith.CSharp",
  "name": "NovaCore modular monolith (.NET 10 Web API)",
  "description": "A .NET 10 modular-monolith Web API on the NovaCore packages: an API host, a sample vertical-slice module, integration tests with an in-memory OpenID Connect issuer, and a CI workflow that checks the migrations and bundles them.",
  "shortName": "novacore",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "MyService",
  "preferNameDirectory": true,
  "symbols": {
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Where the access tokens the API accepts come from.",
      "choices": [
        {
          "choice": "BuiltIn",
          "description": "The host runs its own OpenID Connect provider (NovaCore.Identity.OpenIddict): accounts, sign-in pages and tokens."
        },
        {
          "choice": "External",
          "description": "An external OpenID Connect provider (Entra ID, Keycloak, ...) issues the tokens; the host only validates them through Jwt:Authority."
        }
      ],
      "defaultValue": "BuiltIn"
    },
    "BuiltInAuth": {
      "type": "computed",
      "value": "(auth == \"BuiltIn\")"
    },
    "db": {
      "type": "parameter",
      "datatype": "choice",
      "description": "The database of every module context. The host chooses it (AddModuleDatabase in Program.cs) and keeps the migrations; the modules don't.",
      "choices": [
        {
          "choice": "SqlServer",
          "description": "SQL Server (Microsoft.EntityFrameworkCore.SqlServer, MIT)."
        },
        {
          "choice": "PostgreSql",
          "description": "PostgreSQL (Npgsql.EntityFrameworkCore.PostgreSQL, PostgreSQL license: a named exception of eng/check-licenses.sh)."
        }
      ],
      "defaultValue": "SqlServer"
    },
    "DbSqlServer": {
      "type": "computed",
      "value": "(db == \"SqlServer\")"
    },
    "DbPostgreSql": {
      "type": "computed",
      "value": "(db == \"PostgreSql\")"
    },
    "multitenancy": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Sells to many organizations: the NovaCore.MultiTenancy add-on (tenants, members, their roles and life cycle), and the Todos module's todos belong to a tenant, under /api/v1/tenants/{tenant}/todos.",
      "defaultValue": "false"
    },
    "PostgreSqlMigrationsFolder": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "Migrations"
      },
      "fileRename": "MigrationsPostgreSql"
    },
    "SqlServerTenantMigrationsFolder": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "Migrations"
      },
      "fileRename": "SqlServerTenantMigrations"
    },
    "PostgreSqlTenantMigrationsFolder": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "Migrations"
      },
      "fileRename": "PostgreSqlTenantMigrations"
    },
    "HttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 7000,
        "high": 7300,
        "fallback": 7001
      },
      "replaces": "NOVACORE_HTTPS_PORT"
    },
    "HttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5300,
        "fallback": 5001
      },
      "replaces": "NOVACORE_HTTP_PORT"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!BuiltInAuth)",
          "exclude": [
            "src/Api/MyService.Api/Identity/**",
            "tests/MyService.Api.Tests/IdentityProviderTests.cs"
          ]
        },
        {
          "condition": "(!multitenancy)",
          "exclude": [
            "src/Api/MyService.Api/MultiTenancy/**",
            "src/Api/MyService.Api/Todos/SqlServerTenantMigrations/**",
            "src/Api/MyService.Api/Todos/PostgreSqlTenantMigrations/**",
            "tests/MyService.Api.Tests/TenantTodosTests.cs"
          ]
        },
        {
          "condition": "(multitenancy)",
          "exclude": [
            "src/Api/MyService.Api/Todos/Migrations/**",
            "src/Api/MyService.Api/Todos/MigrationsPostgreSql/**",
            "tests/MyService.Api.Tests/TodosTests.cs"
          ]
        },
        {
          "condition": "(!DbSqlServer)",
          "exclude": [
            "src/Api/MyService.Api/Todos/Migrations/**",
            "src/Api/MyService.Api/Todos/SqlServerTenantMigrations/**",
            "src/Api/MyService.Api/Identity/Migrations/**",
            "src/Api/MyService.Api/MultiTenancy/Migrations/**"
          ]
        },
        {
          "condition": "(!DbPostgreSql)",
          "exclude": [
            "src/Api/MyService.Api/Todos/MigrationsPostgreSql/**",
            "src/Api/MyService.Api/Todos/PostgreSqlTenantMigrations/**",
            "src/Api/MyService.Api/Identity/MigrationsPostgreSql/**",
            "src/Api/MyService.Api/MultiTenancy/MigrationsPostgreSql/**"
          ]
        }
      ]
    }
  ]
}
