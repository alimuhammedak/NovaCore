<Project>

  <!-- Central package management: every package version is set here, once; the .csproj files name packages only. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      The NovaCore packages this project was created with. Upgrade them together. The packages are BMD.NovaCore.*; the
      assemblies and namespaces inside them are NovaCore.*.
    -->
    <NovaCoreVersion>NOVACORE_PACKAGE_VERSION</NovaCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="BMD.NovaCore.AspNetCore" Version="$(NovaCoreVersion)" />
    <PackageVersion Include="BMD.NovaCore.EntityFrameworkCore" Version="$(NovaCoreVersion)" />
    <PackageVersion Include="BMD.NovaCore.OpenTelemetry" Version="$(NovaCoreVersion)" />
    <PackageVersion Include="BMD.NovaCore.Scalar" Version="$(NovaCoreVersion)" />
<!--#if (BuiltInAuth) -->
    <PackageVersion Include="BMD.NovaCore.Identity.OpenIddict" Version="$(NovaCoreVersion)" />
<!--#endif -->
  </ItemGroup>

  <ItemGroup>
    <!-- The database provider the host gives every module context (Program.cs, AddModuleDatabase). -->
<!--#if (DbSqlServer) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
<!--#endif -->
<!--#if (DbPostgreSql) -->
    <!-- PostgreSQL license, with its driver Npgsql: a named exception of eng/check-licenses.sh. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
<!--#endif -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
<!--#if (DbSqlServer) -->
    <!--
      Microsoft.Data.SqlClient (under EF Core SqlServer) depends on System.Security.Cryptography.Pkcs 9.0.11, which has
      high-severity advisories. Every project that references the SQL Server provider references the patched version
      directly. Remove it once the SqlClient that EF Core brings depends on a patched Pkcs.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
<!--#endif -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v3 on Microsoft.Testing.Platform, the runner global.json selects for `dotnet test`: no VSTest packages. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

</Project>
