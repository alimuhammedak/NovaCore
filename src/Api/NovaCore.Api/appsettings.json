{
  "ConnectionStrings": {
    "Database": "Server=localhost;Database=NovaCore;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Jwt": {
    "Issuer": "novacore",
    "Audience": "novacore.api",
    "//SigningKey": "REQUIRED in production (>=32 bytes). Set via user-secrets/env, never commit it.",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Identity": {
    "Seed": {
      "//": "SeedOnStartup requires the DB to be migrated. Set the admin password via user-secrets.",
      "SeedOnStartup": false,
      "AdminEmail": "admin@novacore.local",
      "AdminPassword": ""
    }
  },
  "Cache": {
    "DefaultExpiration": "00:05:00"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
