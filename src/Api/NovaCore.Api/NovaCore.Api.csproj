<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The host: a thin composition root. References the NovaCore packages plus every business module, and does
    nothing but compose them. Program.cs is ~15 lines.
  -->
  <PropertyGroup>
    <UserSecretsId>novacore-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The host chooses the database of every module context (AddModuleDatabase): SQL Server. Their migrations live in
      this project, the modules' and the identity provider's (docs/plan/DECISIONS.md D-073, RESEARCH R-060).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Lifts SqlClient's vulnerable System.Security.Cryptography.Pkcs (see Directory.Packages.props). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- Dev-only: lets `dotnet ef` use the Api as the startup project for every context's migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\NovaCore.AspNetCore\NovaCore.AspNetCore.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\NovaCore.EntityFrameworkCore\NovaCore.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\NovaCore.Serilog\NovaCore.Serilog.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\NovaCore.OpenTelemetry\NovaCore.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\NovaCore.Scalar\NovaCore.Scalar.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\NovaCore.Identity.OpenIddict\NovaCore.Identity.OpenIddict.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\NovaCore.Modules.Catalog\NovaCore.Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\Modules\Payments\NovaCore.Modules.Payments\NovaCore.Modules.Payments.csproj" />
  </ItemGroup>

</Project>
