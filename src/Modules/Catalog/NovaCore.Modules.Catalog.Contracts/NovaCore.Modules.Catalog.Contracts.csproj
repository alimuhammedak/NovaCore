<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Catalog.Contracts: the ONLY surface other modules may depend on. Pure interfaces, DTOs and the events Catalog
    publishes; no implementation, no EF (NovaCore.Abstractions only for the DomainEvent base). Payments references
    this — never the Catalog module itself.
    Not a NuGet package: the Catalog module is sample code for the template, and only the building blocks ship as
    packages (docs/plan/DECISIONS.md D-001, D-020).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\NovaCore.Abstractions\NovaCore.Abstractions.csproj" />
  </ItemGroup>

</Project>
