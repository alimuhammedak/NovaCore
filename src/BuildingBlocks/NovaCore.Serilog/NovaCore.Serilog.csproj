<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NovaCore.Serilog: optional add-on. Serilog as the host's logging provider (console, plus Seq when configured).
    Third-party packages live in add-ons so the core packages stay Microsoft-only (docs/plan/DECISIONS.md D-003).
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>NovaCore add-on: Serilog structured logging for the host (console, plus Seq when configured).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
