<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core.Abstractions: UI-agnostic kernel. BCL only — no ASP.NET, no EF, no runtime NuGet dependency
    (build-time analyzers with PrivateAssets=all are fine). Anything every layer can depend on with zero coupling lives here.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>NovaCore building blocks: Result, paging, base entities and messaging abstractions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
