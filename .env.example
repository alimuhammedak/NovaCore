# Copy to .env (git-ignored, next to docker-compose.yml) and replace the placeholders with strong values.
# docker compose reads .env automatically; never commit the real file.

# SQL Server's SA password (docker-compose.yml, service sqlserver).
MSSQL_SA_PASSWORD=<set-a-strong-password>

# PostgreSQL's postgres password (docker-compose.yml, service postgres).
POSTGRES_PASSWORD=<set-a-strong-password>

# Keycloak's bootstrap admin password (docker-compose.keycloak.yml, optional).
KEYCLOAK_ADMIN_PASSWORD=<set-a-strong-password>
